# Solarized Dark (built-in theme)
theme = iTerm2 Solarized Dark

font-family = Monaco
font-size = 12

# macOS: Option types accented characters (é, è, à, ç, ô…).
# Without this, the U.S. / U.S. International layouts turn
# Option-as-Alt on by themselves and break composition.
macos-option-as-alt = false

# Send Opt+arrows as CSI Alt explicitly (Kitty/iTerm do it natively).
# Used by tmux for pane switching (bind -n M-…).
keybind = opt+up=text:\x1b[1;3A
keybind = opt+down=text:\x1b[1;3B
keybind = opt+right=text:\x1b[1;3C
keybind = opt+left=text:\x1b[1;3D

# Pas de prompt "Quit Ghostty?" / "Close terminal?" en sortie
confirm-close-surface = false
